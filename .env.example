# DevOS credentials
#
# Copy this file to .env and fill in the values, or run:
#   npm run setup
#
# .env is gitignored. Existing process environment variables take precedence.

# AI providers (at least one is recommended)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# GitHub integration (issues and pull requests)
GITHUB_TOKEN=

# Optional Supabase integration (CI and future cloud features)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Optional project root override
# DEVOS_ROOT=
