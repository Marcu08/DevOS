{
  "name": "@marcu08/devos",
  "version": "2.1.0",
  "description": "Autonomous AI software engineering orchestration framework",
  "license": "MIT",
  "author": "Marcu",
  "homepage": "https://github.com/Marcu08/DevOS#readme",
  "bugs": {
    "url": "https://github.com/Marcu08/DevOS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcu08/DevOS.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "devos": "./cli.js"
  },
  "files": [
    "agent/",
    "agents/",
    "providers/",
    "plugins/",
    "dashboard/",
    "config/",
    "scripts/",
    "docs/",
    "dotfiles/",
    "assets/",
    "examples/",
    "cli.js",
    "version.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node cli.js",
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/setup.js --notice",
    "test": "node tests/runner.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov node tests/runner.js",
    "bench": "node scripts/bench.js",
    "doctor": "node cli.js doctor",
    "lint": "knip"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcu08/DevOS.git"
  },
  "keywords": [
    "ai",
    "agents",
    "autonomous",
    "code-generation",
    "orchestration",
    "software-engineering"
  ],
  "devDependencies": {
    "c8": "^10.1.3",
    "knip": "^6.26.0"
  }
